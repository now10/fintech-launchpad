# =============================================================
# FINTECH LAUNCHPAD — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# =============================================================

# App
APP_URL="https://your-app-url.com"
NODE_ENV="development"

# Supabase
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"

# GoCardless (server-side only — never expose CLIENT_SECRET to the frontend)
GOCARDLESS_API_URL="https://api.gocardless.com"
GOCARDLESS_CLIENT_ID="your-gocardless-client-id"
GOCARDLESS_CLIENT_SECRET="your-gocardless-client-secret"
GOCARDLESS_ACCESS_TOKEN="your-gocardless-access-token"
GOCARDLESS_REDIRECT_URI="https://your-app-url.com/oauth/callback"
GOCARDLESS_WEBHOOK_SECRET="your-gocardless-webhook-secret"

# Frontend-safe GoCardless (public client ID only)
VITE_GOCARDLESS_CLIENT_ID="your-gocardless-client-id"
VITE_GOCARDLESS_REDIRECT_URI="https://your-app-url.com/oauth/callback"
